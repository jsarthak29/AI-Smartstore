# ===== Backend =====
# Postgres connection (used by FastAPI + alembic). Inside docker-compose this points at the postgres service.
DATABASE_URL=postgresql+asyncpg://smartstore:smartstore@postgres:5432/smartstore
SYNC_DATABASE_URL=postgresql+psycopg2://smartstore:smartstore@postgres:5432/smartstore

# JWT
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Uploads
UPLOAD_DIR=/app/uploads

# Default seed tenant (only used by seed.py)
SEED_TENANT_NAME=Raj Grocery
SEED_ADMIN_EMAIL=admin@smartstore.app
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_EMAIL=staff@smartstore.app
SEED_STAFF_PASSWORD=staff123

# ===== Frontend (Vite reads only VITE_*) =====
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
